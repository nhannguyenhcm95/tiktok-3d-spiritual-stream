# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=file:./dev.db
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password

# Frontend
VITE_SERVER_URL=http://localhost:3001

# TikTok provider: configure only after selecting and validating an allowed connector.
# Never put cookies, session tokens or provider secrets into VITE_* variables.
LIVE_PROVIDER=mock
TIKTOK_LIVE_USERNAME=
TIKTOK_PROVIDER_ENDPOINT=
